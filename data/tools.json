{
  "asOf": "2026-10-27",
  "note": "Capabilities describe features, not model quality. Update this file when tools change.",
  "tools": [
    {
      "id": "claude-code",
      "name": "Claude Code",
      "homepage": "https://claude.com/claude-code",
      "install": "npm install -g @anthropic-ai/claude-code",
      "detect": {
        "bins": [
          "claude"
        ],
        "homeDirs": [
          ".claude"
        ],
        "extensions": [
          "anthropic.claude-code"
        ]
      },
      "capabilities": {
        "agent": true,
        "inline": false,
        "largeContext": true,
        "local": false,
        "freeTier": false
      },
      "rulesFile": "CLAUDE.md",
      "run": "claude \"{task}\"",
      "review": "claude \"Review the uncommitted changes and the last commit for bugs, security issues and missing tests\"",
      "editorName": "Claude Code"
    },
    {
      "id": "codex",
      "name": "Codex CLI",
      "homepage": "https://github.com/openai/codex",
      "install": "npm install -g @openai/codex",
      "detect": {
        "bins": [
          "codex"
        ],
        "homeDirs": [
          ".codex"
        ],
        "extensions": [
          "openai.chatgpt"
        ]
      },
      "capabilities": {
        "agent": true,
        "inline": false,
        "largeContext": false,
        "local": false,
        "freeTier": false
      },
      "rulesFile": "AGENTS.md",
      "run": "codex \"{task}\"",
      "review": "codex \"Review the uncommitted changes and the last commit for bugs, security issues and missing tests\"",
      "editorName": "Codex"
    },
    {
